# Normalize line endings to LF on commit, checkout as-is
* text=auto eol=lf

# Explicitly LF for these file types
*.py text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sh text eol=lf
*.txt text eol=lf
*.env text eol=lf

# Binary files — no line ending conversion
*.sqlite binary
*.sqlite-shm binary
*.sqlite-wal binary
*.feather binary
*.parquet binary
*.h5 binary
