# -------------------------------------------------------
# .env.example — copy this to .env and fill in real values
# .env is gitignored and must NEVER be committed
# -------------------------------------------------------

# Exchange API credentials
# For paper trading, these are NOT required.
# Only add a key when moving to live trading (Layer 6+).
# Key must be READ-ONLY with zero trading or withdrawal permissions.
EXCHANGE_API_KEY=your_read_only_api_key_here
EXCHANGE_API_SECRET=your_api_secret_here

# Exchange name (e.g. binance, kraken)
EXCHANGE_NAME=binance

# Trading mode — keep as "paper" until Layer 6 is justified by sustained evidence
# Options: paper | live
TRADING_MODE=paper

# Notification webhook (optional — for trade alerts)
# WEBHOOK_URL=
